{
  "settings": {
    "number_of_shards": 1,
    "number_of_replicas": 0,
    "refresh_interval": "1s"
  },
  "mappings": {
    "dynamic": "strict",
    "properties": {
      "run_id": {
        "type": "keyword"
      },
      "source_id": {
        "type": "keyword"
      },
      "event_id": {
        "type": "keyword"
      },
      "mode": {
        "type": "keyword"
      },
      "raw": {
        "type": "text"
      },
      "parse_status": {
        "type": "keyword"
      },
      "parsed": {
        "type": "object",
        "enabled": false
      },
      "parse_error": {
        "properties": {
          "code": {
            "type": "keyword"
          },
          "message": {
            "type": "text"
          }
        }
      }
    }
  }
}